# OpenAI-compatible LLM API used for spam classification.
# Any provider works (DeepSeek, OpenAI, local vLLM/ollama gateway, ...).
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-v4-flash

# Your x.com handle (without @). Used to find your recent posts and to
# never flag yourself.
X_USERNAME=your_handle

# How to reach Chrome:
#   auto — attach to your already-running Chrome (normal profile, keeps your
#          x.com login). Requires Chrome 144+ with remote debugging enabled
#          once at chrome://inspect/#remote-debugging.
#   url  — connect to a Chrome started with scripts/launch-chrome.sh
#          (dedicated debug profile) at CHROME_DEBUG_URL.
CHROME_CONNECT=auto
CHROME_DEBUG_URL=http://127.0.0.1:9222

# How many of your recent posts to scan, and how many replies to load per post.
MAX_POSTS=5
MAX_REPLIES_PER_POST=100
