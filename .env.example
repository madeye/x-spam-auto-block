# OpenAI-compatible LLM API used for spam classification.
# Any provider works (DeepSeek, OpenAI, local vLLM/ollama gateway, ...).
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-v4-flash

# Your x.com handle (without @). Used to find your recent posts and to
# never flag yourself.
X_USERNAME=your_handle

# DevTools endpoint of the running Chrome (see scripts/launch-chrome.sh).
CHROME_DEBUG_URL=http://127.0.0.1:9222

# How many of your recent posts to scan, and how many replies to load per post.
MAX_POSTS=5
MAX_REPLIES_PER_POST=100
